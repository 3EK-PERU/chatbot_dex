{
  "FastApi": {
    "BaseUrl": "http://localhost:8000",
    "AnalyzePath": "/analyze"
  },
  "Planogram": {
    "RequiredClasses": [
      "coca_cola_500ml",
      "sprite_500ml"
    ],
    "MinimumByClass": {
      "coca_cola_500ml": 4,
      "sprite_500ml": 2
    },
    "MinimumConfidence": 0.35
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
